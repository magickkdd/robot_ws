<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="my_tool">

  <!-- 定义工具的材质（亮蓝色，方便区分） -->
  <material name="tool_blue">
    <color rgba="0.0 0.5 1.0 1.0"/>
  </material>

  <!-- 定义工具 Link -->
  <link name="end_effector_tool">
    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.15"/>
      </geometry>
      <material name="tool_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.15"/>
      </geometry>
    </collision>
  </link>

  <!-- 增加一个工具尖端坐标系 (TCP)，方便以后计算拆卸位置 -->
  <link name="tool_tip"/>
  <joint name="tool_to_tip" type="fixed">
    <parent link="end_effector_tool"/>
    <child link="tool_tip"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

</robot>
