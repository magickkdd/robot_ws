<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="battery">

  <!-- ================= 1. 参数定义 ================= -->
  <xacro:property name="main_h" value="0.2"/>      <!-- 主体高度 -->
  <xacro:property name="flange_h" value="0.04"/>   <!-- 法兰厚度 -->
  <xacro:property name="flange_w" value="0.8"/>    <!-- 法兰长度（缩小） -->
  <xacro:property name="flange_d" value="0.5"/>    <!-- 法兰宽度（缩小） -->
  
  <xacro:property name="bolt_radius" value="0.015"/> <!-- 半径(直径0.04) -->
  <xacro:property name="bolt_length" value="0.06"/> <!-- 总高 -->
  <xacro:property name="bolt_z" value="0.11"/>      <!-- 中心Z轴高度 -->
  <!-- 【新增参数】螺栓向内缩进的距离。数字越大，离中心越近 -->
  <xacro:property name="inward_offset" value="0.0"/> 

  <!-- 【修复语法】所有数学运算必须写在 ${ } 里面 -->
  <xacro:property name="bolt_x_off" value="${flange_w/2 - bolt_radius - inward_offset}"/> 
  <xacro:property name="bolt_y_off" value="${flange_d/2 - bolt_radius - inward_offset}"/> 

  <!-- 材质定义 -->
  <material name="dark_gray"><color rgba="0.0 0.0 0.5 1.0"/></material>
  <material name="flange_orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
  <material name="bolt_silver"><color rgba="0.8 0.8 0.8 1.0"/></material>

  <!-- ================= 2. 紧固件宏定义 ================= -->
  <!-- 在 link 外部定义宏，方便多次调用 -->
  <xacro:macro name="bolt_v" params="x y name_suffix">
    <visual name="bolt_visual_${name_suffix}">
      <origin xyz="${x} ${y} ${bolt_z}" rpy="0 0 0"/>
      <geometry><cylinder radius="${bolt_radius}" length="${bolt_length}"/></geometry>
      <material name="bolt_silver"/>
    </visual>
    <collision name="bolt_collision_${name_suffix}">
      <origin xyz="${x} ${y} ${bolt_z}" rpy="0 0 0"/>
      <geometry><cylinder radius="${bolt_radius}" length="${bolt_length}"/></geometry>
    </collision>
  </xacro:macro>


  <!-- ================= 3. 实体结构 ================= -->

  <!-- A. 电池主体 -->
  <link name="battery_link">
    <inertial>
      <origin xyz="0 0 ${main_h/2}" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${main_h/2}" rpy="0 0 0"/>
      <geometry><box size="0.7 0.4 ${main_h}"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${main_h/2}" rpy="0 0 0"/>
      <geometry><box size="0.7 0.4 ${main_h}"/></geometry>
    </collision>
  </link>

  <!-- B. 法兰凸起 (独立Link确保颜色) -->
  <link name="flange_link">
    <inertial>
      <origin xyz="0 0 ${main_h/2}" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${main_h/2}" rpy="0 0 0"/>
      <geometry><box size="${flange_w} ${flange_d} ${flange_h}"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${main_h/2}" rpy="0 0 0"/>
      <geometry><box size="${flange_w} ${flange_d} ${flange_h}"/></geometry>
    </collision>
  </link>

  <joint name="base_to_flange" type="fixed">
    <parent link="battery_link"/>
    <child link="flange_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- C. 紧固件集合 (减少数量以匹配缩小的电池包) -->
  <link name="bolts_link">
    <inertial>
      <origin xyz="0 0 ${bolt_z}" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <!-- 使用参数化位置调用宏 -->
    <!-- 四个角 -->
    <xacro:bolt_v x="${bolt_x_off}"  y="${bolt_y_off}" name_suffix="corner_1"/>
    <xacro:bolt_v x="${bolt_x_off}"  y="-${bolt_y_off}" name_suffix="corner_2"/>
    <xacro:bolt_v x="-${bolt_x_off}" y="${bolt_y_off}" name_suffix="corner_3"/>
    <xacro:bolt_v x="-${bolt_x_off}" y="-${bolt_y_off}" name_suffix="corner_4"/>
    <!-- 长边中间各一个 -->
    <xacro:bolt_v x="0" y="${bolt_y_off}" name_suffix="mid_top"/>
    <xacro:bolt_v x="0" y="-${bolt_y_off}" name_suffix="mid_bottom"/>
  </link>

  <joint name="base_to_bolts" type="fixed">
    <parent link="battery_link"/>
    <child link="bolts_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>