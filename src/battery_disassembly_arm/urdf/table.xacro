<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="table">
    <link name="table_link">
        <!-- 惯性属性：Ignition/Gazebo 必须 -->
        <inertial>
            <origin xyz="0 0 0.4" rpy="0 0 0"/>
            <mass value="50.0"/>
            <inertia ixx="10.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="10.0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.4"/>
            <geometry>
            <box size="2 1.5 0.8"/>
            </geometry>
            <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
        </visual>
        <collision>
            <origin xyz="0 0 0.4"/>
            <geometry>
            <box size="2 1.5 0.8"/>
            </geometry>
        </collision>
    </link>

    <!-- Joint定义移到environment.xacro中，避免重复 -->
</robot>