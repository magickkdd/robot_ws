<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="workcell">

    <!-- 仿真参数 -->
    <xacro:arg name="sim_ignition" default="false" />
    <xacro:arg name="sim_gazebo" default="false" />
    <xacro:arg name="simulation_controllers" default="" />

    <!-- 1. 定义一个全局的、虚拟的世界原点 -->
    <link name="world"/>

    <!-- 2. 引入桌子的 Xacro 文件 -->
    <xacro:include filename="$(find battery_disassembly_arm)/urdf/table.xacro" />

    <!-- 3. 把桌子固定在世界原点上 -->
    <joint name="world_to_table" type="fixed">
        <parent link="world" />
        <child link="table_link" /> <!-- 这里填你在 table.xacro 中定义的 link 名字 -->
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- 4. 引入官方的 UR 机械臂宏 (直接使用官方的，最省事) -->
    <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

    <!-- 5. 调用机械臂宏，并把它固定在桌子上 -->
    <xacro:ur_robot
        name="ur"
        tf_prefix=""
        parent="table_link"
        joint_limits_parameters_file="$(find ur_description)/config/ur10e/joint_limits.yaml"
        kinematics_parameters_file="$(find ur_description)/config/ur10e/default_kinematics.yaml"
        physical_parameters_file="$(find ur_description)/config/ur10e/physical_parameters.yaml"
        visual_parameters_file="$(find ur_description)/config/ur10e/visual_parameters.yaml"
        sim_ignition="$(arg sim_ignition)"
        sim_gazebo="$(arg sim_gazebo)"
        initial_positions="${xacro.load_yaml('$(find battery_disassembly_arm)/config/initial_joint_positions.yaml')}" >

        <!-- 还原机械臂原始位置 -->
        <origin xyz="0 -0.35 0.8" rpy="0 0 ${pi/2}" />
    </xacro:ur_robot>
    <!-- 6. 引入电池的 Xacro 文件 -->
    <xacro:include filename="$(find battery_disassembly_arm)/urdf/battery.xacro" />

    <!-- 7. 把电池固定在桌面上 -->
    <joint name="table_to_battery" type="fixed">
        <parent link="table_link" />
        <child link="battery_link" />
        <origin xyz="0 0.3 0.8" rpy="0 0 0" />
    </joint>

    <!-- 10. 引入工具文件 -->
    <xacro:include filename="$(find battery_disassembly_arm)/urdf/tool.xacro" />

    <!-- 11. 把工具挂载到机械臂的末端法兰 (tool0) 上 -->
    <joint name="arm_to_tool" type="fixed">
        <parent link="tool0" />
        <child link="end_effector_tool" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- 12. Ignition Gazebo ros2_control 插件 -->
    <xacro:if value="$(arg sim_ignition)">
        <gazebo>
            <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(arg simulation_controllers)</parameters>
                <controller_manager_node_name>controller_manager</controller_manager_node_name>
            </plugin>
        </gazebo>
    </xacro:if>

    <!-- 11. Classic Gazebo ros2_control 插件 -->
    <xacro:if value="$(arg sim_gazebo)">
        <gazebo>
            <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
                <parameters>$(arg simulation_controllers)</parameters>
            </plugin>
        </gazebo>
    </xacro:if>

</robot>
